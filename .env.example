# Copy this file to .env and fill it in. .env is gitignored.

# Port for the Express API. package.json's "proxy" points at this port,
# and the React dev server is pinned to 3000 by the "client" script.
PORT=3050

# MongoDB connection string (local MongoDB, or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/tripJournals

# Secret used to sign login tokens. Use a long random string, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# TinyMCE (rich text editor) API key from https://www.tiny.cloud
REACT_APP_TINYMCE_API_KEY=
