{
  "name": "react-express-boilerplate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "config": "^4.4.2",
    "dotenv": "^8.2.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "mongoose": "^9.10.1"
  },
  "devDependencies": {
    "@emotion/core": "^10.0.28",
    "@emotion/styled": "^10.0.27",
    "@tinymce/tinymce-react": "^6.3.0",
    "axios": "^1.20.0",
    "concurrently": "^9.0.0",
    "dompurify": "^3.4.15",
    "emotion-theming": "^10.0.27",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-router-dom": "^5.3.4",
    "react-scripts": "5.0.1",
    "react-table-v6": "^6.8.6",
    "sweetalert2": "^11.26.25"
  },
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"yarn server\" \"yarn client\"",
    "server": "node --watch lib/server.js",
    "client": "PORT=3000 react-scripts start",
    "dev": "PORT=3000 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --env=jsdom",
    "seeds": "node lib/seeds/index.js",
    "eject": "react-scripts eject"
  },
  "proxy": "http://localhost:3050",
  "resolutions": {
    "@babel/runtime": "^7.26.10",
    "lodash": "^4.18.0",
    "nth-check": "^2.0.1",
    "path-parse": "^1.0.7",
    "resolve-url-loader": "^5.0.0",
    "serialize-javascript": "^7.0.5",
    "underscore": "^1.13.8",
    "uuid": "^11.1.1",
    "yaml": "^1.10.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
